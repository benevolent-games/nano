{
	"name": "@benev/nano",
	"version": "0.1.0-0",
	"description": "a little game",
	"license": "MIT",
	"type": "module",
	"main": "./x/index.js",
	"files": [
		"x",
		"s"
	],
	"scripts": {
		"link": "npm link ../tact ../math ../archimedes ../web",
		"build": "bash fix-babylon && rm -rf x && mkdir x x/client && ln -s ../../temp x/client/assets && tsc && scute --in=s/client --out=x/client --splitting=no -v",
		"dev": "octo 'tsc -w' 'node --watch x/test.js' 'scute --in=s/client --out=x/client --splitting=no -vw' 'hottie x/client --debounce=700'",
		"test": "node x/test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"classic-level@3.0.0": true
	},
	"dependencies": {
		"@babylonjs/lite": "^1.0.1",
		"@benev/archimedes": "^0.1.0-7",
		"@benev/math": "^0.3.4",
		"@benev/tact": "^0.2.0",
		"@e280/shiny": "^0.1.0-22",
		"@e280/sly": "^0.4.0-next.2",
		"@e280/strata": "^0.4.0-next.4",
		"@e280/stz": "^0.3.0",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@e280/hottie": "^0.1.1",
		"@e280/octo": "^0.1.1",
		"@e280/science": "^0.1.11",
		"@e280/scute": "^0.4.1",
		"typescript": "^6.0.3"
	},
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"homepage": "https://github.com/benev-gg/nano#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benev-gg/nano.git"
	},
	"bugs": {
		"url": "https://github.com/benev-gg/nano/issues"
	},
	"keywords": [
		"nanoshooter game",
		"web game"
	]
}
